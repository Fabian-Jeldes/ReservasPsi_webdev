{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reservas-psicoandi",
  "compatibility_date": "2026-05-04",
  "main": "./worker/index.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    // Todas las rutas se prerenderizan en build; lo que no exista responde 404.html con status 404
    "not_found_handling": "404-page",
    // El Worker solo se invoca para el proxy de PostHog; el resto lo sirven los assets
    "run_worker_first": ["/ingest/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
